<Window x:Class="SqeaksDaocTextures.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SqeaksDaocTextures"
        Title="Sqeak's DAoC Textures - Installer" Height="810" Width="1060"
        MinHeight="660" MinWidth="880" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        Icon="Assets/SqeaksDaocTextures.ico"
        AutomationProperties.Name="Sqeak's DAoC Textures - Installer">
  <Window.Resources>
    <Style x:Key="ComponentListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComponentToggleStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="RowBorder" CornerRadius="9" Padding="12,7"
                    Background="{DynamicResource RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckBorder" Width="21" Height="21" CornerRadius="5"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock x:Name="CheckGlyph" Text="&#x2713;" FontSize="14" FontWeight="Bold"
                             Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
      <Setter Property="Tag" Value="{DynamicResource SecondaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ComponentState.NotInstalled}">
          <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
          <Setter Property="Tag" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ComponentState.TextureActive}">
          <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
          <Setter Property="Tag" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ComponentState.OriginalActive}">
          <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
          <Setter Property="Tag" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ComponentState.Missing}">
          <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
          <Setter Property="Tag" Value="{DynamicResource DisabledTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ComponentState.Conflict}">
          <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
          <Setter Property="Tag" Value="{DynamicResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="54" Height="60" CornerRadius="8,8,18,18" Margin="0,0,15,0"
              Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentHoverBrush}" BorderThickness="1">
        <TextBlock Text="S" FontFamily="Cambria" FontSize="30" FontWeight="Bold"
                   Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Sqeak's DAoC Textures" Style="{StaticResource DisplayTitleStyle}" />
        <TextBlock Text="Pick your game folder and choose the texture sets you'd like to use. Your originals stay safe."
                   Style="{StaticResource MutedTextStyle}" Margin="1,4,0,0" />
        <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
          <TextBlock Text="Created by Sqeak" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="  &#x2022;  Built and tested for Eden. Live and other servers are untested."
                     FontSize="12" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
      </StackPanel>
      <Grid Grid.Column="2" VerticalAlignment="Top">
        <Button x:Name="ThemeButton" Style="{StaticResource GhostButtonStyle}" Click="ThemeButton_Click"
                ToolTip="Choose how the installer looks" AutomationProperties.Name="Theme selection">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ThemeButtonText" Text="System theme" VerticalAlignment="Center" />
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Popup x:Name="ThemePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ThemeButton}"
               StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-22" VerticalOffset="4">
          <Border CornerRadius="9" Padding="6" MinWidth="170" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <Button Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left"
                      Tag="System" Click="ThemeChoice_Click" AutomationProperties.Name="Follow Windows theme">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="SystemThemeCheck" Text="&#x2713;" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="Follow Windows" />
                </Grid>
              </Button>
              <Button Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left"
                      Tag="Light" Click="ThemeChoice_Click" AutomationProperties.Name="Use light theme">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="LightThemeCheck" Text="&#x2713;" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="Light" />
                </Grid>
              </Button>
              <Button Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left"
                      Tag="Dark" Click="ThemeChoice_Click" AutomationProperties.Name="Use dark theme">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="DarkThemeCheck" Text="&#x2713;" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="Dark" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Grid>

    <Border Grid.Row="1" CornerRadius="12" Padding="18,15" Margin="0,0,0,16"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Choose locations" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
        <Grid Grid.Row="1" Margin="0,0,0,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
              <TextBlock Text="DAoC folder" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="TargetValidationText" Text="Not selected" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="24,2,0,0" MaxWidth="166" HorizontalAlignment="Left"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBox x:Name="TargetPathBox" Grid.Column="1" TextChanged="PathBox_TextChanged" AutomationProperties.Name="Dark Age of Camelot folder" />
          <Button x:Name="BrowseTargetButton" Grid.Column="2" Content="Browse..." Margin="10,0,0,0"
                  Click="BrowseTarget_Click" AutomationProperties.Name="Browse for DAoC folder" />
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
              <TextBlock Text="Texture archives" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="ArchiveValidationText" Text="Not selected" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="24,2,0,0" MaxWidth="166" HorizontalAlignment="Left"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBox x:Name="ArchivePathBox" Grid.Column="1" TextChanged="PathBox_TextChanged" AutomationProperties.Name="Texture archive Part 1 or Part 2 path" />
          <Button x:Name="BrowseArchiveButton" Grid.Column="2" Content="Browse..." Margin="10,0,0,0"
                  Click="BrowseArchive_Click" AutomationProperties.Name="Browse for either texture archive part" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2" CornerRadius="12" Padding="18,15,10,10" Margin="0,0,0,14"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,8,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Texture folders" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock x:Name="SelectionSummaryText" Text="Choose the folders you want to install."
                       Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SelectAvailableButton" Content="Select available" Style="{StaticResource GhostButtonStyle}"
                    Click="SelectAvailable_Click" AutomationProperties.Name="Select all available folders" />
            <Button x:Name="ClearSelectionButton" Content="Clear" Style="{StaticResource GhostButtonStyle}"
                    Click="ClearSelection_Click" AutomationProperties.Name="Clear folder selection" />
          </StackPanel>
        </Grid>
        <ListBox x:Name="ComponentsList" Grid.Row="1" ItemsSource="{Binding Components}"
                 Style="{StaticResource ComponentListStyle}"
                 ItemContainerStyle="{StaticResource ComponentListItemStyle}"
                 AutomationProperties.Name="Texture folders">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Style="{StaticResource ComponentToggleStyle}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="105"/><ColumnDefinition Width="170"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Texture folder" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,1,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="FILES" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                    <TextBlock Text="{Binding FileCountDisplay}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="SIZE" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                    <TextBlock Text="{Binding SizeDisplay}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateDisplay}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}"
                               FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </CheckBox>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="3" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
            Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel>
          <TextBlock Text="Your original folders are always backed up." FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock Text="You can switch between the original and new textures after installation."
                     Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" CornerRadius="12" Padding="15,12"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StatusIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Choose a valid DAoC folder and texture archive."
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,9,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="FolderProgressLabelText" Text="Current folder" Style="{StaticResource MutedTextStyle}" FontSize="11" />
              <TextBlock x:Name="FolderProgressPercentText" Grid.Column="1" Text="0%"
                         Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="10,0,0,0" />
            </Grid>
            <ProgressBar x:Name="FolderProgressBar" Minimum="0" Maximum="100" Value="0"
                         Margin="0,3,0,0" AutomationProperties.Name="Current folder progress" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Overall progress" Style="{StaticResource MutedTextStyle}" FontSize="11" />
              <TextBlock x:Name="OverallProgressPercentText" Grid.Column="1" Text="0%"
                         Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="10,0,0,0" />
            </Grid>
            <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="100" Value="0"
                         Margin="0,3,0,0" AutomationProperties.Name="Overall operation progress" />
            <TextBlock x:Name="CurrentFileText" Style="{StaticResource MutedTextStyle}" FontSize="11"
                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButtonStyle}"
                  Click="Refresh_Click" AutomationProperties.Name="Refresh folders" />
          <Button x:Name="SwapButton" Content="Switch selected" Margin="8,0,0,0"
                  Click="Swap_Click" IsEnabled="False" AutomationProperties.Name="Switch selected folders" />
          <Button x:Name="UninstallButton" Content="Uninstall selected" Style="{StaticResource DestructiveButtonStyle}"
                  Margin="8,0,0,0" Click="Uninstall_Click" IsEnabled="False"
                  AutomationProperties.Name="Uninstall selected texture folders" />
          <Button x:Name="InstallButton" Content="Install textures" Style="{StaticResource PrimaryButtonStyle}"
                  Margin="8,0,0,0" Click="Install_Click" IsEnabled="False" AutomationProperties.Name="Install selected textures" />
          <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0"
                  Click="Cancel_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel operation" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
