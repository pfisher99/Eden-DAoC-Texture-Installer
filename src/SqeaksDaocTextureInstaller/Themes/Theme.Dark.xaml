<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColor">#16130F</Color>
  <Color x:Key="SurfaceColor">#211C15</Color>
  <Color x:Key="RaisedSurfaceColor">#2A231A</Color>
  <Color x:Key="InputBackgroundColor">#1B1712</Color>
  <Color x:Key="PrimaryTextColor">#F4E7CA</Color>
  <Color x:Key="SecondaryTextColor">#C2B18D</Color>
  <Color x:Key="BorderColor">#514431</Color>
  <Color x:Key="HoverColor">#342B20</Color>
  <Color x:Key="SelectedColor">#493A24</Color>
  <Color x:Key="DisabledSurfaceColor">#211D17</Color>
  <Color x:Key="DisabledTextColor">#887B66</Color>
  <Color x:Key="AccentColor">#D2A85C</Color>
  <Color x:Key="AccentHoverColor">#E2BD72</Color>
  <Color x:Key="AccentPressedColor">#B88D43</Color>
  <Color x:Key="AccentTextColor">#21170B</Color>
  <Color x:Key="SuccessColor">#91C194</Color>
  <Color x:Key="SuccessSurfaceColor">#243528</Color>
  <Color x:Key="WarningColor">#E0AE60</Color>
  <Color x:Key="WarningSurfaceColor">#3B2D18</Color>
  <Color x:Key="ErrorColor">#E18A7F</Color>
  <Color x:Key="ErrorSurfaceColor">#412520</Color>
  <Color x:Key="FocusColor">#E4B961</Color>
  <Color x:Key="OverlayColor">#66000000</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="{StaticResource RaisedSurfaceColor}" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="{StaticResource ErrorSurfaceColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>
